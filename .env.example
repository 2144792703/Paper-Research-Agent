# ============================================================
# 模块一：模型路由
#   remote -> 远程 OpenAI 兼容 API（默认）
#   local  -> 本地 Ollama 服务
# ============================================================
MODEL_PROVIDER=remote


# ============================================================
# 模块二：远程模型（OpenAI 兼容接口）
# ============================================================
MODEL=your-model-name
API_KEY=your-api-key
API_KEY_POOLS=your-api-key-1,your-api-key-2,your-api-key-3
BASE_URL=https://api.deepseek.com/v1

REQUEST_TIMEOUT=180.0
MAX_RETRIES=0
KEY_COOLDOWN=5
RPM_LIMIT=10


# ============================================================
# 模块三：本地模型（Ollama）
#   仅当 MODEL_PROVIDER=local 时生效
# ============================================================
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q5_K_M
OLLAMA_TIMEOUT=300


# ============================================================
# 模块四：论文搜索与筛选参数
#   命令行参数 --search-count / --papers 优先，未指定时使用这里的值
# ============================================================
SEARCH_MAX_RESULTS=15   # 单次搜索拉取数量，范围 1-50
KEEP_PAPERS=5           # 最终保留论文数量，范围 1-10


# ============================================================
# 模块五：可观测性（Langfuse）
#   key 只写在 .env，不要提交；缺任一 key 时自动跳过上报
# ============================================================
LANGFUSE_PUBLIC_KEY=lf-pk-your-public-key
LANGFUSE_SECRET_KEY=lf-sk-your-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com


# ============================================================
# 模块六：LLM 磁盘缓存与成本统计
# ============================================================
CACHE_ENABLED=1          # 0 表示关闭缓存（调试用）
CACHE_VERSION=1          # prompt/缓存格式大改或影响输出的代码逻辑变更时 +1，旧缓存全部失效
# CACHE_DIR=./.cache      # 默认项目根目录 .cache

# 采样参数：参与缓存键；留空表示不传参（用服务端默认）
# LLM_TEMPERATURE=0.0
# LLM_TOP_P=1.0

# 单价表（litellm），默认 prices/model_prices_and_context_window.json
# MODEL_PRICES_PATH=prices/model_prices_and_context_window.json
# 表里查不到的模型可手动给单价（美元/百万 token，两项都填才生效）
# MODEL_PRICE_INPUT_PER_1M=0
# MODEL_PRICE_OUTPUT_PER_1M=0
# 可选：人民币展示汇率
# USD_TO_CNY=7.2
