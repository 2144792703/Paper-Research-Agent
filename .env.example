# ============================================================
# 模块一：模型路由（唯一开关）
#   remote -> 远程 OpenAI 兼容 API（BASE_URL + API_KEY_POOLS）
#   local  -> 本地 Ollama 服务
#   注意：容器内 127.0.0.1 指向容器自身；要用 local 需把
#         OLLAMA_HOST 改成容器可访问的 Ollama 地址（如：OLLAMA_HOST=http://host.docker.internal:11434），否则选 remote
# ============================================================
MODEL_PROVIDER=remote


# ============================================================
# 模块二：远程模型（OpenAI 兼容接口，MODEL_PROVIDER=remote 时生效）
#   key 两种用法：
#     池化：API_KEY_POOLS=key1,key2,key3（轮换 + 单 key 冷却 + 全局 RPM 限流）
#     单个：API_KEY_POOLS 只填一个，或留空改用下方 API_KEY
# ============================================================
MODEL=your-model-name
# 轻量节点（筛选 / 路由 / 单篇总结 / 追问）用的廉价模型；留空回退 MODEL
MODEL_CHEAP=
# 轻量模型关闭思考/推理：1=关闭（默认），0=保留；仅远程且轻量模型与主模型不同时生效
CHEAP_MODEL_DISABLE_THINKING=1

BASE_URL=https://api.deepseek.com/v1

API_KEY_POOLS=your-api-key-1,your-api-key-2,your-api-key-3
# 备用单 key 写法（API_KEY_POOLS 为空时的回退项）
# API_KEY=your-api-key

REQUEST_TIMEOUT=180.0
MAX_RETRIES=0
# 混沌测试：按概率在 LLM 请求前注入可重试故障（0 关闭；0-1，仅远程模式生效，调试时临时开启）
CHAOS_FAILURE_RATE=0.0

# 单 key 限流退避基数（秒），退避按 5→10→20→40 递增，封顶 60s
KEY_COOLDOWN=5
# 全局跨 key 每分钟请求上限，0 表示关闭节流（默认 0）；开启时建议为官方 RPM 的 80%（官方 RPM 为 10 则配置设为 8）
RPM_LIMIT=0


# ============================================================
# 模块三：本地模型（MODEL_PROVIDER=local 时生效）
# ============================================================
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q5_K_M
# 轻量节点（筛选 / 路由 / 单篇总结 / 追问）用的本地廉价模型；留空回退 OLLAMA_MODEL
OLLAMA_MODEL_CHEAP=
OLLAMA_TIMEOUT=300


# ============================================================
# 模块四：论文搜索与总结参数
#   命令行 --search-count / --papers 优先，未指定时用这里
# ============================================================
# 单次搜索拉取数量，范围 1-50
SEARCH_MAX_RESULTS=15
# 最终保留论文数量，范围 1-10
KEEP_PAPERS=5
# 单篇总结并发度，范围 1-8；本地模型建议调小（如 1-2）
SUMMARY_CONCURRENCY=3


# ============================================================
# 模块五：可观测性（Langfuse）
#   key 只写在 .env，不要提交；缺任一 key 时自动跳过上报
# ============================================================
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# SDK 优先读 LANGFUSE_BASE_URL，此项作为兼容写法
LANGFUSE_HOST=https://cloud.langfuse.com


# ============================================================
# 模块六：LLM 磁盘缓存与成本统计
#   缓存目录默认 ./.cache（已 gitignore / dockerignore）
# ============================================================
CACHE_ENABLED=1
# prompt/缓存格式大改或影响输出的代码逻辑变更时 +1，旧缓存全部失效
CACHE_VERSION=1
# CACHE_DIR=./.cache

# 采样参数：参与缓存键；留空表示不传参、用服务端默认
# LLM_TEMPERATURE=0.0
# LLM_TOP_P=1.0

# 单价表默认用 prices/model_prices_and_context_window.json
# MODEL_PRICES_PATH=prices/model_prices_and_context_window.json
# 表里查不到的模型可手动给单价，单位：美元/百万 token，两项都填才生效
# MODEL_PRICE_INPUT_PER_1M=
# MODEL_PRICE_OUTPUT_PER_1M=
# 可选：人民币展示汇率
# USD_TO_CNY=7.2
