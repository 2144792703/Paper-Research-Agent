# ============================================================
# 模块一：模型路由
#   remote -> 远程 OpenAI 兼容 API（默认）
#   local  -> 本地 Ollama 服务
# ============================================================
MODEL_PROVIDER=remote


# ============================================================
# 模块二：远程模型（OpenAI 兼容接口）
# ============================================================
MODEL=your-model-name
API_KEY=your-api-key
API_KEY_POOLS=your-api-key-1,your-api-key-2,your-api-key-3
BASE_URL=https://api.deepseek.com/v1

REQUEST_TIMEOUT=180.0
MAX_RETRIES=0
KEY_COOLDOWN=5
RPM_LIMIT=10


# ============================================================
# 模块三：本地模型（Ollama）
#   仅当 MODEL_PROVIDER=local 时生效
# ============================================================
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:7b-instruct-q5_K_M
OLLAMA_TIMEOUT=300


# ============================================================
# 模块四：论文搜索与筛选参数
#   命令行参数 --search-count / --papers 优先，未指定时使用这里的值
# ============================================================
SEARCH_MAX_RESULTS=15   # 单次搜索拉取数量，范围 1-50
KEEP_PAPERS=5           # 最终保留论文数量，范围 1-10
